// Bindings for the deployed Cloudflare worker.
//
// Nitro reads this file at build time and merges it into the wrangler.json it
// writes to .output/server/, so this is the one place a service is attached to
// the worker. Nothing in it is needed to run the app locally.
//
// D1 is where accounts and shared playlists live once deployed: the worker has
// no disk to put a file on, so without a binding every account would be lost on
// the next cold start. It is the same Cloudflare account as the worker — no
// second vendor, no key, no separate bill.
//
// To turn it on:
//   1. npx wrangler d1 create muis          (prints a database_id)
//   2. paste that id below and delete the "//" markers
//   3. deploy
//
// Until then the worker answers exactly as it did before: it reports accounts as
// unavailable, and everything that does not need an account keeps working.
{
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "muis",
  //     "database_id": "PASTE_THE_DATABASE_ID_HERE"
  //   }
  // ]
}
